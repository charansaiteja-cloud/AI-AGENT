# Copy to .env and adjust for your machine. Every value below is optional;
# the application ships with working defaults for local development.

# development | production | test
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# SQLite by default. Use an absolute path in production.
DATABASE_URL=sqlite+aiosqlite:///./data/support_agent.db

# Optional shared-secret API key. When set, every /api route except health
# requires an X-API-Key header. Set VITE_API_KEY to the same value when
# building the bundled frontend.
# APP_API_KEY=
# VITE_API_KEY=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_PREDICT=512
OLLAMA_HISTORY_MESSAGES=20
OLLAMA_TEMPERATURE=0.2

# Hindsight long-term memory
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_BANK_PREFIX=support-customer
HINDSIGHT_TIMEOUT_SECONDS=30
HINDSIGHT_ENABLED=true
HINDSIGHT_RECALL_LIMIT=8

# Uploads and request limits
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_EXTENSIONS=.png,.jpg,.jpeg,.gif,.webp,.txt,.md,.csv,.json,.pdf
MAX_ATTACHMENT_TEXT_CHARS=20000
MAX_MESSAGE_LENGTH=4000
MAX_ATTACHMENTS_PER_MESSAGE=5

# Rate limiting (per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=30

# Built frontend served by FastAPI in production.
# STATIC_DIR=./frontend/dist
